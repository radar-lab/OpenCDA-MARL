<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- Vehicle type definitions -->
    <vType id="car" accel="2.6" decel="4.5" sigma="0.5" length="5.0" maxSpeed="70.0" guiShape="passenger"/>

    <!-- Routes for MARL training -->
    <!-- Note: Simple network, vehicles drive through single edges -->
    <!-- MARL agents control vehicles via TraCI as they approach intersection -->

    <route id="route_0" edges="0"/>
    <route id="route_1" edges="1"/>
    <route id="route_2" edges="2"/>
    <route id="route_3" edges="3"/>

    <!-- Traffic flows - vehicles spawn on edges and are controlled by MARL -->
    <!-- Flow rate: 100 veh/hour = ~1.7 veh/min per direction -->
    <flow id="flow_0" type="car" route="route_0" begin="0" end="3600" vehsPerHour="100"/>
    <flow id="flow_1" type="car" route="route_1" begin="0" end="3600" vehsPerHour="100"/>
    <flow id="flow_2" type="car" route="route_2" begin="0" end="3600" vehsPerHour="100"/>
    <flow id="flow_3" type="car" route="route_3" begin="0" end="3600" vehsPerHour="100"/>

</routes>
